#!/bin/bash
# Times every new model on 300 rows per dataset, to size the real jobs
# (fastdetect_<model>.job) from real throughput instead of a guess. Rows go
# to separate _calib_* folders so they don't mix into the real runs.
#SBATCH --job-name=calib-new-models
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --mem=120G
#SBATCH --time=00:45:00
#SBATCH --output=calib-new-models-%j.log

set -eo pipefail
module purge
module load 2025
module load Python/3.13.5-GCCcore-14.3.0
cd "$HOME/Multi-lingual-NLP"
source .venv/bin/activate

export HF_HOME="$HOME/hf_cache"
export HF_HUB_OFFLINE=1

# Llama last: it's gated, and without a Hugging Face token it isn't downloaded
for model in Qwen/Qwen3-1.7B Qwen/Qwen3-4B utter-project/EuroLLM-1.7B HuggingFaceTB/SmolLM2-1.7B HuggingFaceTB/SmolLM2-360M meta-llama/Llama-3.2-3B-Instruct; do
    for dataset in multisocial multitude; do
        srun python -u score.py --detector fastdetect --dataset "$dataset" --scoring "$model" \
            --dataset-limit 300 --run-folder "_calib_${model//\//-}_$dataset" \
            || echo "CALIBRATION FAILED: $model $dataset"  # one model failing shouldn't stop the others
    done
done
