#!/bin/bash
#SBATCH --job-name=detectgpt_mt_gpt2
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=18
#SBATCH --mem=120G
#SBATCH --time=14:00:00   # calibrated: 5.5 rows/s on real gpu_a100 -> ~10.4h for 206330 rows, ~1.3x margin. If it still hits the wall, resubmit this same file -- score.py resumes from scores.csv.
#SBATCH --output=slurm-%j.out

module purge
module load 2025
module load Python/3.13.5-GCCcore-14.3.0
cd $HOME/Multi-lingual-NLP
source .venv/bin/activate
export HF_HOME=$HOME/hf_cache
export HF_HUB_OFFLINE=1

srun python score.py --detector detectgpt --dataset multitude --scoring gpt2 \
    --detectgpt-mask google/mt5-small --resume
